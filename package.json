{
  "name": "task-progress-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "Local task tracker with offline edits and PostgreSQL synchronization",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "backup": "node server/backup.js",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1"
  },
  "dependencies": { "pg": "^8.16.3", "lucide": "^0.468.0" },
  "devDependencies": { "fake-indexeddb": "^6.2.4" }
}
